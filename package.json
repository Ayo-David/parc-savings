{
  "name": "@parc/savings",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@1.22.19",
  "engines": {
    "node": "22.21.1",
    "yarn": "1.22.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/db/schema && cp db/schema/current.sql dist/db/schema/current.sql",
    "dev": "tsx watch src/server.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "migrate:latest": "node --import tsx ./node_modules/knex/bin/cli.js --knexfile knexfile.ts migrate:latest",
    "migrate:runtime": "KNEX_MIGRATIONS_COMPILED=true node ./node_modules/knex/bin/cli.js --knexfile dist/knexfile.js migrate:latest",
    "seed:pr01": "tsx scripts/seed-pr01.ts",
    "start": "node dist/src/server.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand --watchman=false",
    "typecheck": "tsc --noEmit",
    "validate": "yarn format:check && yarn lint && yarn typecheck && yarn test && yarn build"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jose": "^6.2.12",
    "knex": "^3.3.0",
    "pg": "^8.23.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "rimraf": "^6.0.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0"
  }
}
